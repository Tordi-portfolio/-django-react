# Copy this file to .env.local for local overrides.
#
# Leave VITE_API_URL unset (or set to /api) for local development — the
# Vite dev server proxies /api/* to http://localhost:8000 automatically
# (see vite.config.js), so the browser never needs a cross-origin request.
#
# For a production build, point this at your deployed Django API's origin:
# VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=/api
